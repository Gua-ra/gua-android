<!-- GUA FORK: declarations the Play build does not ship. The feature behind each removal stays off
     while BuildMeta.isGooglePlayBuild is true. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location sharing (DefaultLocationService). -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove" />

    <application>
        <service
            android:name="io.element.android.features.location.impl.live.service.LiveLocationSharingService"
            tools:node="remove" />
    </application>

</manifest>
