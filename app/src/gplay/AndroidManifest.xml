<!-- GUA FORK: declarations the Play build does not ship. The feature behind each removal stays off
     while BuildMeta.isGooglePlayBuild is true, or checks the permission before using it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location sharing (DefaultLocationService). -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove" />

    <!-- Calls (DefaultSessionEnterpriseService, DefaultCallNotificationEventResolver,
         FullScreenIntentPermissionsPresenter). -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CAMERA"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />

    <!-- Installing an APK received in a conversation (AndroidLocalMediaActions opens the file
         without the installer prompt). -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <service
            android:name="io.element.android.features.location.impl.live.service.LiveLocationSharingService"
            tools:node="remove" />

        <service
            android:name="io.element.android.features.call.impl.services.CallForegroundService"
            tools:node="remove" />

        <!-- Declared by the element-call library, which lint cannot see from this module. -->
        <service
            android:name="io.element.android.call.impl.services.ElementCallForegroundService"
            tools:ignore="MissingClass"
            tools:node="remove" />
    </application>

</manifest>
