# GUA FORK — release/upload signing template.
#
# Copy to app/keystore.properties (gitignored) and fill in, OR provide the same values via the
# environment variables below (env takes precedence). Used by app/build.gradle.kts to sign the
# release/nightly build; without it the release build falls back to the debug keystore, which
# Google Play rejects.
#
#   storeFile      <- GUA_RELEASE_KEYSTORE            absolute path to the upload .jks
#   storePassword  <- GUA_RELEASE_KEYSTORE_PASSWORD
#   keyAlias       <- GUA_RELEASE_KEY_ALIAS
#   keyPassword    <- GUA_RELEASE_KEY_PASSWORD
#
# Generate an upload key:
#   keytool -genkeypair -v -keystore ~/gua-upload.jks -alias gua-upload \
#     -keyalg RSA -keysize 4096 -validity 10950 -storetype PKCS12 \
#     -dname "CN=Gua, O=Gua, C=BR"
#
# Enroll this key as the UPLOAD key in Google Play App Signing. Back up the .jks + passwords.

storeFile=/absolute/path/to/gua-upload.jks
storePassword=CHANGME
keyAlias=gua-upload
keyPassword=CHANGME
