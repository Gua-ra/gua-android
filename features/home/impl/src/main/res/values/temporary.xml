<resources>

    <!-- GUA FORK: the encryption repair banner. Replaces upstream's "confirm your recovery key"
         copy, which asks for a key Gua never shows anyone. -->
    <string name="gua_encryption_repair_title">Finish setting up this device</string>
    <string name="gua_encryption_repair_message">Complete setup to access encrypted chats and message history available on this device.</string>
    <string name="gua_encryption_repair_action">Finish setup</string>

    <!-- GUA FORK: shown on every signed-in device while someone is recovering this account with the
         delayed recovery, so the owner can stop it. Not dismissible.

         This group is carried only by the four Gua languages (en, es, fr, pt-BR); every other locale
         falls back to these strings. The last sentence is the security instruction the whole banner
         exists for, so a locale that carried half the group would be worse than English: translate
         the group as a whole or leave it out as a whole. -->
    <string name="gua_account_recovery_banner_title">Someone started recovering your account</string>
    <!-- %1$s is a localised long date including the year, for example "6 April 2026", never a time
         of day: the waits run in days, so a moment says more than the owner can act on. "from" and
         not "after", because the server's instant falls somewhere inside that date and "after" would
         claim a deadline up to a day later than the one the recovery actually has. -->
    <string name="gua_account_recovery_banner_message_later">It can be finished from %1$s. If this was you, you can ignore this. If it wasn\'t, cancel it from a device where you are still signed in.</string>
    <string name="gua_account_recovery_banner_message_now">It can be finished now. If this was you, you can ignore this. If it wasn\'t, cancel it from a device where you are still signed in.</string>
    <!-- The server reported no moment this recovery can be finished, so the banner says nothing
         about timing rather than claiming it can be finished now. -->
    <string name="gua_account_recovery_banner_message_generic">If this was you, you can ignore this. If it wasn\'t, cancel it from a device where you are still signed in.</string>
    <string name="gua_account_recovery_banner_action">Cancel recovery</string>
    <string name="gua_account_recovery_cancel_title">Cancel recovery?</string>
    <string name="gua_account_recovery_cancel_message">Cancel it if you didn\'t start it. If you did, you will have to start again.</string>
    <string name="gua_account_recovery_cancelled">Recovery cancelled</string>
    <string name="gua_account_recovery_cancel_failed">Couldn\'t cancel the recovery. Try again.</string>
</resources>
