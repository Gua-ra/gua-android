<!-- GUA FORK: French (Québécois) translations for Gua-custom login/onboarding strings.
     English source of truth lives in values/temporary.xml. This file is the fork analogue of
     Localazy translations.xml for Gua-only keys (which Localazy cannot regenerate for a fork).
     Welcome strings ported from Element X iOS fr.lproj; phone-entry ported from iOS
     screen_phone_login_* keys; country picker translated to match iOS tone. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Onboarding / welcome (ported from iOS screen_onboarding_welcome_title + the end-to-end
         encrypted trust pill shown below it). -->
    <string name="screen_onboarding_welcome_title">"Bienvenue sur Gua"</string>
    <string name="screen_onboarding_trust_encrypted">"Chiffrement de bout en bout"</string>

    <!-- Phone-first entry (ported from iOS screen_phone_login_* / screen_phone_entry_*). -->
    <string name="screen_phone_entry_welcome_title">"Bienvenue sur Gua"</string>
    <string name="screen_phone_entry_title">"Quel est votre numéro ?"</string>
    <string name="screen_phone_entry_message">"Entrez votre numéro de téléphone"</string>
    <string name="screen_phone_entry_footer">"Nous enverrons un code de vérification par texto à ce numéro."</string>
    <string name="screen_phone_entry_phone_number_label">"Numéro de téléphone"</string>
    <string name="screen_phone_entry_country_picker_a11y">"Choisir le pays"</string>

</resources>
