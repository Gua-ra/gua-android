<resources>
    <!-- Gua onboarding/welcome copy. English source of truth lives here (temporary.xml);
         the obsolete Element values were removed from localazy.xml to avoid a duplicate-resource
         collision. Mirrors Element X iOS (screen_onboarding_welcome_title + the end-to-end
         encrypted trust pill shown below it). -->
    <string name="gua_onboarding_welcome_title">Welcome to Gua</string>
    <string name="gua_onboarding_welcome_message">Private messaging, made simple.</string>
    <string name="screen_onboarding_trust_encrypted">End-to-end encrypted</string>

    <!-- Gua phone-first entry (Stage 3). Mirrors Element X iOS PhoneEntryScreen. -->
    <string name="screen_phone_entry_welcome_title">Welcome to Gua</string>
    <string name="screen_phone_entry_title">What\'s your number?</string>
    <string name="screen_phone_entry_message">Enter your phone number</string>
    <string name="screen_phone_entry_footer">We\'ll text a verification code to this number.</string>
    <string name="screen_phone_entry_phone_number_label">Phone number</string>
    <string name="screen_phone_entry_country_picker_a11y">Select country</string>

    <!-- Gua sign in with a passkey. Button on the phone-entry screen; the passkey is a discoverable
         credential, so it identifies the account on its own: choosing this sends no code. Same key as
         iOS Untranslated.strings. -->
    <string name="gua_sign_in_with_passkey">Sign in with a passkey</string>

    <!-- Gua account genesis (ADM-008 Phase 3). Shown only when the device meant to register its own
         account key and could not: the signup stops rather than quietly creating an account without
         one. Deliberately says nothing about keys or genesis, which are not user-facing ideas. -->
    <string name="gua_account_setup_failed">We could not finish setting up your account on this device. Please try again.</string>

    <!-- Gua resolver asked the app to try again later (HTTP 429 or 503). Same copy as the iOS
         gua_resolver_* keys. %1$s is a duration from gua_retry_wait_seconds or gua_retry_wait_minutes. -->
    <string name="gua_resolver_routing_unavailable">We\'re having trouble connecting right now. Please try again in a moment.</string>
    <string name="gua_resolver_routing_unavailable_retry_in">We\'re having trouble connecting right now. Please try again in %1$s.</string>
    <string name="gua_resolver_rate_limited">Too many attempts. Please wait a moment and try again.</string>
    <string name="gua_resolver_rate_limited_retry_in">Too many attempts. Please try again in %1$s.</string>
    <plurals name="gua_retry_wait_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <plurals name="gua_retry_wait_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
</resources>
