<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="gua_encryption_reset_required_title">部分先前的訊息無法復原</string>
    <string name="gua_encryption_reset_required_message">若要在這台裝置上完成加密聊天的設定，必須重設你的加密備份。僅儲存在該備份中的訊息將會遺失。已在你裝置上的訊息不受影響。</string>
    <string name="gua_encryption_reset_required_action">重設並完成</string>
    <string name="gua_encryption_reset_finishing">正在完成設定…</string>
    <string name="gua_encryption_reset_failed">無法完成設定。請點選「重設並完成」再試一次。</string>
    <string name="gua_encryption_recover_from_other_device_title">復原你先前的訊息</string>
    <string name="gua_encryption_recover_from_other_device_message">使用你的其他裝置，復原這台裝置上還無法使用的訊息。\n\n如果你無法存取該裝置，可以重設並完成設定，但僅儲存在備份中的訊息將永久遺失。</string>
    <string name="gua_encryption_recover_from_other_device_action">使用我的其他裝置</string>
    <string name="gua_encryption_recover_from_other_device_failed">無法從其他裝置取得你的訊息。請確認該裝置上的 Gua 已開啟，然後再試一次，或改為重設。</string>
</resources>
