<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="gua_encryption_reset_required_title">一部の過去のメッセージは復元できません</string>
    <string name="gua_encryption_reset_required_message">この端末で暗号化されたチャットのセットアップを完了するには、暗号化バックアップをリセットする必要があります。そのバックアップにのみ保存されているメッセージは失われます。すでにお使いの端末にあるメッセージには影響しません。</string>
    <string name="gua_encryption_reset_required_action">リセットして完了</string>
    <string name="gua_encryption_reset_finishing">セットアップを完了しています…</string>
    <string name="gua_encryption_reset_failed">セットアップを完了できませんでした。もう一度試すには、「リセットして完了」をタップしてください。</string>
    <string name="gua_encryption_recover_from_other_device_title">過去のメッセージを復元できます</string>
    <string name="gua_encryption_recover_from_other_device_message">他の端末を使って、この端末ではまだ利用できないメッセージを復元してください。\n\nその端末を使用できない場合は、リセットして完了することもできますが、バックアップにのみ保存されているメッセージは完全に失われます。</string>
    <string name="gua_encryption_recover_from_other_device_action">他の端末を使用</string>
    <string name="gua_encryption_recover_from_other_device_failed">他の端末からメッセージを取得できませんでした。その端末でGuaが開いていることを確認して、もう一度お試しいただくか、リセットして完了してください。</string>
</resources>
