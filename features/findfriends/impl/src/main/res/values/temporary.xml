<resources>
    <!-- Gua Find friends (S12 contact discovery). English source of truth lives here (temporary.xml);
         mirrors Element X iOS FindFriendsScreen copy. -->
    <string name="screen_find_friends_title">Find friends</string>

    <!-- New-chat / "+" menu entry. -->
    <string name="screen_find_friends_action">Find friends</string>
    <string name="screen_find_friends_action_description">See which of your contacts are on Gua</string>

    <string name="screen_find_friends_loading">Looking for your contacts on Gua…</string>

    <!-- Permission states. -->
    <string name="screen_find_friends_permission_title">Allow access to Contacts</string>
    <string name="screen_find_friends_permission_message">Gua checks your contacts privately to find which of them are already here. Your contacts are never stored.</string>
    <string name="screen_find_friends_permission_action">Allow access</string>
    <string name="screen_find_friends_permission_denied_action">Open settings</string>

    <!-- Empty state. -->
    <string name="screen_find_friends_empty_title">No contacts on Gua yet</string>
    <string name="screen_find_friends_empty_message">None of your contacts are on Gua yet. Invite them and they\'ll show up here.</string>
    <string name="screen_find_friends_empty_action">Check again</string>

    <!-- Error state. -->
    <string name="screen_find_friends_error_title">Something went wrong</string>
    <string name="screen_find_friends_error_message">We couldn\'t check your contacts right now. Please try again.</string>
    <string name="screen_find_friends_error_action">Try again</string>

    <!-- Results header. "%1$d" is the number of matched contacts. -->
    <plurals name="screen_find_friends_results_header_plural">
        <item quantity="one">%1$d contact is on Gua</item>
        <item quantity="other">%1$d contacts are on Gua</item>
    </plurals>

    <!-- Accessibility. "%1$s" is the contact's name. -->
    <string name="a11y_find_friends_view_profile">View %1$s\'s profile</string>
    <string name="a11y_find_friends_start_chat">Start a chat with %1$s</string>
</resources>
