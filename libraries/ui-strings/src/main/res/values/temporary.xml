<!-- GUA FORK: shared Gua strings, reachable through CommonStrings like the rest of this module.
     English source of truth lives here; localazy.xml is generated and must never be edited. -->
<resources>
    <!-- Shown when an action was refused because the signed-in session's token had expired and the
         one refresh it was given did not settle it. It replaces the generic "an error occurred",
         which told people nothing about the one thing that fixes it: doing it again. -->
    <string name="gua_error_session_refresh_needed">We had to refresh your session. Please try again.</string>
</resources>
