float hash12(float2 p) {
    float3 p3=fract(float3(p.xyx)*0.1031);p3+=dot(p3,p3.yzx+33.33);return fract((p3.x+p3.y)*p3.z);
}

float2 hash22(float2 p) {
    float3 p3=fract(float3(p.xyx)*float3(0.1031,0.1030,0.0973));p3+=dot(p3,p3.yzx+33.33);return fract((p3.xx+p3.yz)*p3.zy);
}

float sq(float x) {
    return x*x;
}

float3 dither(float4 gua_FragCoord, float3 c) {
    float n=hash12(gua_FragCoord.xy)+hash12(gua_FragCoord.yx+17.17)-1.0;return c+n*(1.5/255.0);
}

float2 sendAt(float asp) {
    return (u_origin.x+u_origin.y>0.5)?u_origin/u_res.y:float2(asp*0.83,0.113);
}

float sendGlow(float2 q,float2 o,float asp) {
    float2 v=(q-o)/(0.45*asp);return u_pulse*exp(-3.0*dot(v,v));
}

float ringR(float asp) {
    return 0.02+0.75*asp*pow(max(1.0-u_pulse,0.0),0.6);
}

float bubbleBand(float y) {
    return gua_smoothstep(0.03,0.12,y)*gua_smoothstep(0.62,0.50,y);
}

float vnoise(float2 p) {
    float2 i=floor(p);float2 f=fract(p);f=f*f*(3.0-2.0*f);
      return mix(mix(hash12(i),hash12(i+float2(1.0,0.0)),f.x),mix(hash12(i+float2(0.0,1.0)),hash12(i+float2(1.0,1.0)),f.x),f.y);
}

float3 scene(float2 p,float asp,bool dk) {
    float3 c;
    if(dk) c=mix(float3(0.0627,0.0941,0.1490),float3(0.0431,0.0667,0.1098),gua_smoothstep(0.3,1.0,p.y));
    else   c=mix(float3(0.8275,0.8784,0.8471),float3(0.7882,0.8471,0.8863),gua_smoothstep(0.3,1.0,p.y));
    for(int i=0;i<7;i++){
      float fi=float(i);
      float2 h=hash22(float2(fi*3.1,7.7));
      float2 ct=float2(asp*(0.06+0.88*h.x),0.60+0.30*h.y);
      if(i>4) ct.y=0.22+0.18*h.y;
      float r=mix(0.05,0.11,fract(h.x*7.3+h.y));
      float dd=length(p-ct)/r;
      float disc=gua_smoothstep(1.0,0.70,dd)*(0.78+0.22*gua_smoothstep(0.5,0.92,dd));
      float3 lc;
      if(dk) lc=fi<2.0?float3(0.8863,0.6471,0.3608):(fi<4.0?float3(0.7882,0.3765,0.4784):float3(0.2471,0.6196,0.6902));
      else   lc=fi<3.0?float3(0.4980,0.6588,0.5451):(fi<5.0?float3(0.6157,0.7490,0.5412):float3(0.6588,0.7686,0.7059));
      float a=(i>4?0.45:0.85)*disc;
      if(dk) c+=lc*a*0.50; else c=mix(c,lc,a*0.75);
    }
    return c;
}

half4 main(float2 fragCoord) {
    float4 gua_FragCoord = float4(fragCoord.x, u_res.y - fragCoord.y, 0.0, 1.0);
    float4 gua_FragColor = float4(0.0);
    float asp=u_res.x/u_res.y;
    float2 q=gua_FragCoord.xy/u_res.y;
    float t=u_time;
    bool dk=u_dark>0.5;
    float2 o=sendAt(asp);
    float sg=sendGlow(q,o,asp);
    float bb=bubbleBand(q.y);
    // Wipe: a clear vertical streak above the sent bubble that refills from the top.
    float wtop=o.y+0.75*sqrt(u_pulse);
    float wx=abs(q.x-o.x+0.03*(q.y-o.y));
    float wipe=step(0.02,u_pulse)*gua_smoothstep(0.085,0.045,wx)*gua_smoothstep(o.y-0.02,o.y+0.01,q.y)*gua_smoothstep(wtop,wtop-0.03,q.y);
    float2 off=float2(0.0);
    float shade=0.0; float hi=0.0;
    // Beaded drops: two grids.
    for(int i=0;i<2;i++){
      float fi=float(i);
      float sc=mix(16.0,34.0,fi);
      float2 gp=q*sc+float2(fi*0.37,fi*0.71);
      float2 id=floor(gp); float2 f=fract(gp)-0.5;
      float h=hash12(id+fi*41.0);
      float2 jo=(hash22(id+fi*9.0)-0.5)*0.55;
      float r=mix(0.10,0.30,fract(h*13.1))*(1.0-0.25*fi);
      float on=step(mix(0.35,0.20,fi)+0.25*bb,h)*(1.0-wipe);
      float2 v=(f-jo)/r;
      float l=length(v*float2(1.0,0.92));
      float in_=gua_smoothstep(1.0,0.86,l)*on;
      off+=-v*in_*(r/sc)*2.6;
      shade+=in_*gua_smoothstep(0.55,1.0,l)*gua_smoothstep(-0.2,0.6,-v.y);
      hi+=in_*exp(-dot(v-float2(-0.35,0.40),v-float2(-0.35,0.40))*14.0);
    }
    // Sliding drops: one per column, each leaving a clear trail with a few beads.
    float cw=asp/7.0;
    float ci=floor(q.x/cw);
    float ch=hash12(float2(ci,3.3));
    float per=11.0+9.0*ch;
    float yd=1.15-fract(t/per+ch)*1.4;
    float xd=(ci+0.5)*cw+cw*0.22*sin(yd*9.0+ch*6.0);
    float2 dv=(q-float2(xd,yd))/float2(0.020,0.026);
    float run=gua_smoothstep(1.0,0.85,length(dv))*step(0.35,ch)*(1.0-wipe);
    off+=-dv*run*0.025;
    shade+=run*gua_smoothstep(0.5,1.0,length(dv))*gua_smoothstep(-0.2,0.6,-dv.y);
    hi+=run*exp(-dot(dv-float2(-0.3,0.4),dv-float2(-0.3,0.4))*12.0);
    float trail=step(0.35,ch)*gua_smoothstep(0.012,0.006,abs(q.x-xd))*step(yd,q.y)*gua_smoothstep(yd+0.35,yd+0.02,q.y);
    float3 col=scene(q+off,asp,dk);
    float wedge=exp(-sq((wx-0.072)/0.005))*gua_smoothstep(o.y-0.02,o.y+0.01,q.y)*gua_smoothstep(wtop,wtop-0.03,q.y)*step(0.02,u_pulse);
    // Fine mist on the glass, cleared by trails and by the wipe.
    float mist=(1.0-max(trail,wipe))*(0.65+0.35*vnoise(q*float2(40.0,28.0)));
    if(dk){
      col=mix(col,float3(0.1569,0.1961,0.2745),mist*0.45*(1.0-0.2*bb));
      col=mix(col,float3(0.0196,0.0314,0.0549),clamp(shade,0.0,1.0)*0.25);
      col*=1.0+0.35*clamp(hi+shade,0.0,1.0);
      col+=float3(0.8667,0.9098,1.0000)*clamp(hi,0.0,1.0)*0.40;
      col+=float3(0.4353,0.6275,0.8471)*0.16*sg+float3(0.7490,0.8275,0.9412)*wedge*0.10;
    } else {
      col=mix(col,float3(0.9529,0.9647,0.9608),mist*0.62*(1.0-0.15*bb));
      col=mix(col,float3(0.5608,0.6314,0.6039),clamp(shade,0.0,1.0)*0.40);
      col=mix(col,float3(1.0),clamp(hi,0.0,1.0)*0.85);

      col=mix(col,float3(0.4941,0.5765,0.5373),wedge*0.35);
      col=mix(col,float3(0.7686,0.8667,0.7843),clamp(sg*0.40,0.0,1.0));
    }
    gua_FragColor=float4(dither(gua_FragCoord, clamp(col,0.0,1.0)),1.0);
    return half4(gua_FragColor);
}
