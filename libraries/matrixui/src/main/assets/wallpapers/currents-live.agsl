 * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
 * SOFTWARE.
 */

float hash12(float2 p) {
    float3 p3=fract(float3(p.xyx)*0.1031);p3+=dot(p3,p3.yzx+33.33);return fract((p3.x+p3.y)*p3.z);
}

float wrap16(float x) {
    return x-16.0*floor(x/16.0);
}

float strands(float d,float hc,float s) {
    return min(min(abs(d-hc+s),abs(d-hc)),abs(d-hc-s));
}

half4 main(float2 fragCoord) {
    float4 gua_FragCoord = float4(fragCoord.x, u_res.y - fragCoord.y, 0.0, 1.0);
    float4 gua_FragColor = float4(0.0);
    float k=u_res.x/390.0;
    float2 frag=float2(gua_FragCoord.x,u_res.y-gua_FragCoord.y);
    float2 og=(u_origin.x+u_origin.y>0.5)?u_origin:float2(u_res.x*0.83,u_res.y*0.113);
    float2 o=float2(og.x,u_res.y-og.y);
    float2 dv=frag-o;
    float dist=length(dv);
    float R=0.45*u_res.x;
    float near=exp(-(dist*dist)/(R*R));
    float ring=sin(dist/(11.0*k)-u_time*7.0);
    float env=u_pulse*exp(-dist/R);
    float2 p=frag+(dv/max(dist,1.0))*ring*env*6.0*k+u_tilt*6.0*k+float2(u_time*0.8*k,u_time*0.35*k);
    float cell=44.0*k;
    float2 id=floor(p/cell);
    float2 f=p-id*cell;
    float h=hash12(float2(wrap16(id.x),wrap16(id.y))+0.5);
    float fl=step(h,0.5);
    float2 c1=mix(float2(cell,0.0),float2(0.0),fl);
    float2 c2=mix(float2(0.0,cell),float2(cell),fl);
    float hc=0.5*cell, s=0.2*cell;
    float e1=strands(length(f-c1),hc,s);
    float e2=strands(length(f-c2),hc,s);
    float e=min(e1,e2);
    float cov=clamp(0.55*k+0.5-e,0.0,1.0);
    float2 v=mix(f-c2,f-c1,step(e1,e2));
    float ang=atan(v.y,v.x);
    float g=0.5+0.5*sin(ang*4.0+h*40.0+u_time*0.32+(id.x+id.y)*1.7);
    float glint=gua_smoothstep(0.72,1.0,g);
    float3 top,bot,line,hi,glow;
    if(u_dark>0.5){
      top=float3(0.0745,0.0667,0.0941); bot=float3(0.0706,0.0627,0.0902);
      line=float3(0.1569,0.1451,0.2118); hi=float3(0.2588,0.2314,0.4000); glow=float3(0.4510,0.3725,0.7451);
    } else {
      top=float3(0.9490,0.9373,0.9608); bot=float3(0.9255,0.9098,0.9451);
      line=float3(0.8706,0.8471,0.9098); hi=float3(0.7765,0.7333,0.8824); glow=float3(0.8196,0.7451,0.9608);
    }
    float3 base=mix(top,bot,frag.y/u_res.y);
    float3 lc=mix(line,hi,clamp(glint*0.6+env*1.2,0.0,1.0));
    float3 col=mix(base,lc,clamp(cov*(1.0+env*1.5),0.0,1.0));
    col=mix(col,glow,mix(0.28,0.16,u_dark)*u_pulse*near);
    float n=hash12(gua_FragCoord.xy)+hash12(gua_FragCoord.yx+17.17)-1.0;
    gua_FragColor=float4(col+n*(1.5/255.0),1.0);
    return half4(gua_FragColor);
}
