float hash12(float2 p) {
    float3 p3=fract(float3(p.xyx)*0.1031);p3+=dot(p3,p3.yzx+33.33);return fract((p3.x+p3.y)*p3.z);
}

float2 hash22(float2 p) {
    float3 p3=fract(float3(p.xyx)*float3(0.1031,0.1030,0.0973));p3+=dot(p3,p3.yzx+33.33);return fract((p3.xx+p3.yz)*p3.zy);
}

float sq(float x) {
    return x*x;
}

float3 dither(float4 gua_FragCoord, float3 c) {
    float n=hash12(gua_FragCoord.xy)+hash12(gua_FragCoord.yx+17.17)-1.0;return c+n*(1.5/255.0);
}

float2 sendAt(float asp) {
    return (u_origin.x+u_origin.y>0.5)?u_origin/u_res.y:float2(asp*0.83,0.113);
}

float sendGlow(float2 q,float2 o,float asp) {
    float2 v=(q-o)/(0.45*asp);return u_pulse*exp(-3.0*dot(v,v));
}

float ringR(float asp) {
    return 0.02+0.75*asp*pow(max(1.0-u_pulse,0.0),0.6);
}

float bubbleBand(float y) {
    return gua_smoothstep(0.03,0.12,y)*gua_smoothstep(0.62,0.50,y);
}

float vnoise(float2 p) {
    float2 i=floor(p);float2 f=fract(p);f=f*f*(3.0-2.0*f);
      return mix(mix(hash12(i),hash12(i+float2(1.0,0.0)),f.x),mix(hash12(i+float2(0.0,1.0)),hash12(i+float2(1.0,1.0)),f.x),f.y);
}

float phs(float2 p,float t) {
    float2 w=p+0.09*float2(sin(p.y*2.9+t*0.9),sin(p.x*2.5-t*0.7+1.3))
            +0.035*float2(sin(p.y*6.1-t*0.6+2.0),sin(p.x*5.7+t*0.5));
    return length(w-float2(-0.30,1.30))*24.0+2.4*sin(w.x*2.1-w.y*1.6+t*0.8)+1.2*sin(w.x*4.3+w.y*3.1-t*0.6)-t*1.2;
}

half4 main(float2 fragCoord) {
    float4 gua_FragCoord = float4(fragCoord.x, u_res.y - fragCoord.y, 0.0, 1.0);
    float4 gua_FragColor = float4(0.0);
    float asp=u_res.x/u_res.y;
    float2 q=gua_FragCoord.xy/u_res.y;
    float t=u_time*0.10;
    float2 o=sendAt(asp);
    float2 p=q+u_tilt*0.012;
    float od=length(q-o);
    float wave=exp(-sq((od-ringR(asp))/0.06))*sqrt(u_pulse);
    float e=1.5/u_res.y;
    float ph=phs(p,t)+2.2*wave;
    float phx=phs(p+float2(e,0.0),t);
    float phy=phs(p+float2(0.0,e),t);
    float gm=max(length(float2(phx-ph+2.2*wave,phy-ph+2.2*wave))/e,1.0);
    float x=fract(ph/6.2832);
    float dc=min(x,1.0-x)*6.2832/gm*u_res.y;
    float ridge=exp(-sq(dc/1.3));
    float lit=pow(gua_smoothstep(0.30,1.0,x),1.6);
    float shade=gua_smoothstep(0.0,0.03,x)*(1.0-gua_smoothstep(0.03,0.42,x));
    float k=1.0-0.4*bubbleBand(q.y);
    float hc=fract(ph*0.035+q.x*0.35+q.y*0.25+t*0.25)*3.0;
    float3 col;
    if(u_dark>0.5){
      float3 s0=float3(0.2275,0.2000,0.3294),s1=float3(0.1176,0.2275,0.2667),s2=float3(0.2745,0.1882,0.2784);
      float3 sh=hc<1.0?mix(s0,s1,gua_smoothstep(0.0,1.0,hc)):(hc<2.0?mix(s1,s2,gua_smoothstep(1.0,2.0,hc)):mix(s2,s0,gua_smoothstep(2.0,3.0,hc)));
      col=mix(float3(0.0471,0.0549,0.0824),float3(0.1216,0.1373,0.2039),lit);
      col=mix(col,sh,sq(lit)*0.85*k);
      col=mix(col,float3(0.0275,0.0314,0.0471),shade*0.75);
      col=mix(col,float3(0.6039,0.6510,0.8118),ridge*0.30*mix(0.75,1.0,k));
      col+=float3(0.3765,0.4392,0.6588)*0.30*sendGlow(q,o,asp);
      col=mix(col,float3(0.6039,0.6510,0.8118),wave*0.18);
    } else {
      float3 s0=float3(0.9529,0.8392,0.9098),s1=float3(0.8353,0.9020,0.9686),s2=float3(0.8667,0.9529,0.9020);
      float3 sh=hc<1.0?mix(s0,s1,gua_smoothstep(0.0,1.0,hc)):(hc<2.0?mix(s1,s2,gua_smoothstep(1.0,2.0,hc)):mix(s2,s0,gua_smoothstep(2.0,3.0,hc)));
      col=float3(0.9569,0.9451,0.9647);
      col=mix(col,sh,(0.25+0.75*lit)*0.9*k);
      col=mix(col,float3(0.8627,0.8392,0.8941),shade*0.70*k);
      col=mix(col,float3(1.0),ridge*0.70);
      col=mix(col,float3(0.8627,0.7843,0.9412),clamp(sendGlow(q,o,asp)*0.7,0.0,1.0));
    }
    gua_FragColor=float4(dither(gua_FragCoord, clamp(col,0.0,1.0)),1.0);
    return half4(gua_FragColor);
}
