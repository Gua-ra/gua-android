 * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
 * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
 * SOFTWARE.
 */

float hash12(float2 p) {
    float3 p3=fract(float3(p.xyx)*0.1031);p3+=dot(p3,p3.yzx+33.33);return fract((p3.x+p3.y)*p3.z);
}

float2 hash22(float2 p) {
    float3 p3=fract(float3(p.xyx)*float3(0.1031,0.1030,0.0973));p3+=dot(p3,p3.yzx+33.33);return fract((p3.xx+p3.yz)*p3.zy);
}

float sq(float x) {
    return x*x;
}

float3 dither(float4 gua_FragCoord, float3 c) {
    float n=hash12(gua_FragCoord.xy)+hash12(gua_FragCoord.yx+17.17)-1.0;return c+n*(1.5/255.0);
}

float2 sendAt(float asp) {
    return (u_origin.x+u_origin.y>0.5)?u_origin/u_res.y:float2(asp*0.83,0.113);
}

float sendGlow(float2 q,float2 o,float asp) {
    float2 v=(q-o)/(0.45*asp);return u_pulse*exp(-3.0*dot(v,v));
}

float ringR(float asp) {
    return 0.02+0.75*asp*pow(max(1.0-u_pulse,0.0),0.6);
}

float bubbleBand(float y) {
    return gua_smoothstep(0.03,0.12,y)*gua_smoothstep(0.62,0.50,y);
}

float vnoise(float2 p) {
    float2 i=floor(p);float2 f=fract(p);f=f*f*(3.0-2.0*f);
      return mix(mix(hash12(i),hash12(i+float2(1.0,0.0)),f.x),mix(hash12(i+float2(0.0,1.0)),hash12(i+float2(1.0,1.0)),f.x),f.y);
}

half4 main(float2 fragCoord) {
    float4 gua_FragCoord = float4(fragCoord.x, u_res.y - fragCoord.y, 0.0, 1.0);
    float4 gua_FragColor = float4(0.0);
    float asp=u_res.x/u_res.y;
    float2 q=gua_FragCoord.xy/u_res.y;
    float t=u_time;
    bool dk=u_dark>0.5;
    float2 o=sendAt(asp);
    float sg=sendGlow(q,o,asp);
    float3 sk0,sk1,bk,bl0,bl1,bl2,pt0,pt1;
    if(dk){
      sk0=float3(0.0784,0.1020,0.2000);sk1=float3(0.1373,0.1451,0.2745);bk=float3(0.0431,0.0392,0.0784);
      bl0=float3(0.4784,0.3098,0.0941);bl1=float3(0.8510,0.6196,0.1961);bl2=float3(1.0000,0.8471,0.4667);pt0=float3(0.7529,0.5412,0.1725);pt1=float3(1.0000,0.8588,0.5020);
    } else {
      sk0=float3(0.9725,0.9490,0.9333);sk1=float3(0.8863,0.9255,0.9608);bk=float3(0.4157,0.3333,0.3765);
      bl0=float3(0.7882,0.4000,0.5608);bl1=float3(0.9137,0.5765,0.7137);bl2=float3(0.9843,0.8275,0.8902);pt0=float3(0.8941,0.5412,0.6902);pt1=float3(0.9765,0.8118,0.8784);
    }
    float3 col=mix(sk0,sk1,gua_smoothstep(0.1,1.0,q.y));
    if(dk) col=mix(col,float3(0.2275,0.1843,0.3333),exp(-sq((q.y-0.62)/0.22))*0.30);
    float2 cp=q+u_tilt*0.010;
    // Canopy seen out of focus: soft blossom masses across the top, ragged towards 30%.
    float cn=vnoise(cp*float2(3.2,4.0)+float2(1.3,t*0.004))*0.6+vnoise(cp*float2(7.0,8.0)+float2(7.1,2.2+t*0.006))*0.4;
    float edge=0.76+0.05*sin(cp.x*4.0+0.7);
    float mass=gua_smoothstep(-0.04,0.10,cp.y-edge+(cn-0.5)*0.30);
    float3 cc=mix(bl0,bl1,gua_smoothstep(0.3,0.75,cn));
    cc=mix(cc,bl2,gua_smoothstep(0.62,0.85,vnoise(cp*float2(6.0,7.0)+float2(3.0,9.0)))*0.55);
    col=mix(col,cc,mass*0.92);
    // Defocused blossoms: bokeh discs with a brighter rim, mostly along the canopy edge.
    for(int i=0;i<7;i++){
      float fi=float(i);
      float2 h=hash22(float2(fi*5.3,1.7));
      float2 c=float2(asp*(0.04+0.92*h.x),0.80+0.16*h.y+0.010*sin(t*0.08+fi*1.7));
      float r=0.030+0.028*fract(h.x*7.1+h.y*3.3);
      float dd=length(cp+u_tilt*0.012*(1.0+fi*0.1)-c)/r;
      float bo=gua_smoothstep(1.0,0.86,dd)*(0.75+0.25*gua_smoothstep(0.55,0.95,dd));
      col=mix(col,mix(bl1,bl2,0.35+0.4*h.y),bo*0.55);
    }
    // Falling petals in three depth layers; the send gusts them away from the bubble.
    float bb=bubbleBand(q.y);
    for(int i=0;i<3;i++){
      float fi=float(i);
      float sc=7.0+fi*4.0;
      float2 p=q+u_tilt*(0.004+0.008*(2.0-fi));
      float2 ov=p-o; float od=length(ov);
      p-=ov/(od+0.001)*0.14*u_pulse*exp(-od*5.0);
      p.y+=t*(0.018-fi*0.004);
      p.x+=0.035*sin(p.y*2.5+t*0.15+fi*2.0);
      float2 gp=p*sc;
      float2 id=floor(gp); float2 f=fract(gp)-0.5;
      float h=hash12(id+fi*19.0);
      float2 jo=(hash22(id+fi*3.0)-0.5)*0.5;
      float on=step(0.58,h);
      float ang=t*(0.25+0.4*h)*sign(h-0.79)+h*20.0;
      float2 v=f-jo;
      v=float2x2(cos(ang),sin(ang),-sin(ang),cos(ang))*v;
      float sz=mix(0.085,0.12,fract(h*7.0))*(1.0-fi*0.10);
      float2 e=v/float2(sz,sz*0.62);
      e.x+=0.18*e.y*e.y;
      float rr=length(e);
      float soft=mix(0.10,0.30,1.0-fi*0.5);
      float petal=gua_smoothstep(1.0,1.0-soft,rr)*on;
      float3 pc=mix(pt1,pt0,gua_smoothstep(-0.8,0.9,e.x));
      float al=mix(0.92,0.60,fi*0.5)*(1.0-mix(0.30,0.45,u_dark)*bb);
      col=mix(col,pc,petal*al);
    }
    if(dk) col+=float3(1.0000,0.7882,0.3765)*0.16*sg;
    else   col=mix(col,float3(0.9569,0.7373,0.8235),clamp(sg*0.55,0.0,1.0));
    gua_FragColor=float4(dither(gua_FragCoord, clamp(col,0.0,1.0)),1.0);
    return half4(gua_FragColor);
}
